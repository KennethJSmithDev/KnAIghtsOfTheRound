# Local opt-in profile. The default image and production remain unchanged.
ARG IRIS_IMAGE=docker.iscinternal.com/docker-intersystems/intersystems/irishealth-community:2026.3.0AI.154.0
FROM ${IRIS_IMAGE}
COPY --chown=51773:51773 src/ /opt/knaights/src/
COPY --chown=51773:51773 pex/java/ /opt/knaights/pex/java/
COPY --chown=51773:51773 --chmod=0755 docker/bootstrap.sh /opt/knaights/bootstrap.sh
COPY --chown=51773:51773 docker/bootstrap.script /opt/knaights/bootstrap.script
COPY --chown=51773:51773 --chmod=0755 docker/secure-bootstrap.sh /opt/knaights/secure-bootstrap.sh
COPY --chown=51773:51773 LICENSE NOTICE /opt/knaights/
RUN mkdir -p /tmp/knaights-pex-classes && \
    javac --release 11 -cp /usr/irissys/dev/java/lib/1.8/intersystems-pex-1.0.0-shaded.jar \
      -d /tmp/knaights-pex-classes /opt/knaights/pex/java/knaights/pex/*.java && \
    jar cf /tmp/knaights-pex.jar -C /tmp/knaights-pex-classes .
